isplay-130);--font-h6--weight: 500;--font-h6--letter-spacing: var(--letter-spacing--heading-normal);--font-h6--size: var(--font-size--h6);--font-h6--family: var(--font-subheading--family);--font-h6--style: var(--font-subheading--style);--font-h6--case: none;--font-h6--line-height: var(--line-height--display-130);

    /* Hardcoded font sizes */
    --font-size--2xs: 0.625rem;
