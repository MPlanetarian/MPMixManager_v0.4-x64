<script>
  window.currentShopifyMarketStapeId = null;
  window.currentShopifyMarketStapeCode = null;
  try {
    window.currentShopifyMarketStapeId = "95161254191";
    window.currentShopifyMarketStapeCode = "US";
    // Checkout doesn't render theme app extension blocks, so this is the
    // only place the market/country code is ever set. Persisting it here
    // lets checkout-side field mapping (country_market_code) fall back to
    // the last known value instead of coming up empty.
    localStorage.setItem('marketShopStape', JSON.stringify({
      id: window.currentShopifyMarketStapeId,
      code: window.currentShopifyMarketStapeCode
    }));
  } catch (error) {
    console.error("❌ Stape Error:", error);
  }
</script>





