# ==============================================================================
# MP_Mix_Manager_v0.4 - Environment & Configuration File
# Copy this file to 'config.env' to customize paths and settings.
# ==============================================================================

# Root directory of your music and mix archive.
# Auto-detected defaults across platforms:
#   Linux:   /run/media/$USER/WD BLACK B/MIX_ARCHIVE
#   macOS:   /Volumes/WD BLACK B/MIX_ARCHIVE or /Volumes/MIX_ARCHIVE
#   Windows: D:/MIX_ARCHIVE or /d/MIX_ARCHIVE
# If not configured (MIX_ARCHIVE_CONFIGURED="false"), the application defaults
# to using the root application folder MIX_ARCHIVE ($SCRIPT_DIR/MIX_ARCHIVE).
# Set to "true" once configured via Option 13 or set manually:
MIX_ARCHIVE_CONFIGURED="false"
MIX_ARCHIVE_DIR=""
# MIX_ARCHIVE_DIR="/run/media/$USER/WD BLACK B/MIX_ARCHIVE"
# MIX_ARCHIVE_DIR="/Volumes/WD BLACK B/MIX_ARCHIVE"
# MIX_ARCHIVE_DIR="D:/MIX_ARCHIVE"

# Additional / Multiple Mix Archive Storage Locations (separated by semicolon, comma, or newline)
# Semicolon (;) is recommended on Windows to preserve drive letters (e.g. G:\My Drive\MIX_ARCHIVE;D:\Mixes)
# (e.g. Linux: EXTRA_MIX_ARCHIVE_DIRS="/run/media/$USER/DATA/MIX_ARCHIVE2/FLAC_CONVERTED_OUTPUTS")
# (e.g. Windows: EXTRA_MIX_ARCHIVE_DIRS="G:\My Drive\MIX_ARCHIVE;D:\Mixes\FLAC_CONVERTED_OUTPUTS")
EXTRA_MIX_ARCHIVE_DIRS=""

# Output directory for converted FLAC files (relative to MIX_ARCHIVE_DIR or absolute)
OUTPUT_DIR="FLAC_CONVERTED_OUTPUTS"

# Archive directory for converted WAV source files
ARCHIVE_DIR="CONVERTED_WAV_FILES"

# Spek spectrogram output directory
SPEK_DIR="SPEK_OUTPUTS"

# Traktor Pro History XML directory for automatic tracklist extraction
# Auto-detected across platforms:
#   Linux:   /run/media/$USER/WD BLACK B/MIX_ARCHIVE/Traktor 3.11.1/History
#   macOS:   /Volumes/WD BLACK B/MIX_ARCHIVE/Traktor 3.11.1/History or $HOME/Documents/Native Instruments/Traktor 3.11.1/History
#   Windows: D:/MIX_ARCHIVE/Traktor 3.11.1/History or C:/Users/$USER/Documents/Native Instruments/Traktor 3.11.1/History
# TRAKTOR_HISTORY_DIR="/run/media/$USER/WD BLACK B/MIX_ARCHIVE/Traktor 3.11.1/History"

# Cloud & Remote Backup Destinations (Google Drive, iCloud, Dropbox, Custom Folder)
# Google Drive remote name and path configured in rclone
GDRIVE_REMOTE="gdrive:MIX_ARCHIVE/FLAC_CONVERTED_OUTPUTS"

# Apple iCloud destination folder (macOS native iCloud Drive or local folder)
# Default on macOS: "$HOME/Library/Mobile Documents/com~apple~CloudDocs/MIX_ARCHIVE"
ICLOUD_PATH="${HOME}/Library/Mobile Documents/com~apple~CloudDocs/MIX_ARCHIVE"

# Dropbox destination folder (Local Dropbox sync folder or rclone remote)
# Default: "$HOME/Dropbox/MIX_ARCHIVE" or "dropbox:MIX_ARCHIVE"
DROPBOX_PATH="${HOME}/Dropbox/MIX_ARCHIVE"

# Custom cloud or local backup destination (optional fallback)
# CLOUD_BACKUP_DEST="/run/media/$USER/BACKUP_DRIVE/MIX_ARCHIVE"

# NFT Videos directory for playlist generation
# NFT_VIDEOS_DIR="/run/media/$USER/DATA/NFT_VIDEOS"

# WAN2GP AI Video & Image Generator directories (required before accessing WAN2GP options)
# Set to "true" once configured:
WAN2GP_CONFIGURED="false"
# WAN2GP_DIR: Root of Wan2GP repo / application
#   Windows: "X:/WAN2GP/Wan2GP" or "D:/WAN2GP/Wan2GP"
#   Linux:   "$HOME/pinokio/api/wan.git/app" or "/var/home/$USER/pinokio/api/wan.git/app"
# WAN2GP_DIR="X:/WAN2GP/Wan2GP"
# WAN2GP_PYTHON: Python interpreter with PyTorch / CUDA installed
#   Windows: "X:/WAN2GP/conda_envs/wan2gp/python.exe"
#   Linux:   "$HOME/pinokio/api/wan.git/app/venv/bin/python"
# WAN2GP_PYTHON="X:/WAN2GP/conda_envs/wan2gp/python.exe"
# WAN2GP_OUTPUTS: Main output folder for generated videos, images, and audio
#   Windows: "D:/DATA_DRIVE_MOVED/WAN2GP_OUTPUTS"
#   Linux:   "/run/media/$USER/GAMES1/DATA_DRIVE_MOVED/WAN2GP_OUTPUTS"
# WAN2GP_OUTPUTS="D:/DATA_DRIVE_MOVED/WAN2GP_OUTPUTS"
# WAN2GP_FLUX_BATCH_DIR: Batch workspace for Flux 2 Klein 9B (contains CTRL_IMAGE, PROCESSED)
#   Windows: "D:/DATA_DRIVE_MOVED/WAN2GP_FLUX_BATCH"
#   Linux:   "/run/media/$USER/GAMES1/DATA_DRIVE_MOVED/WAN2GP_FLUX_BATCH"
# WAN2GP_FLUX_BATCH_DIR="D:/DATA_DRIVE_MOVED/WAN2GP_FLUX_BATCH"
# WAN2GP_LTX_BATCH_DIR: Batch workspace for LTX Video 2B/13B/22B (contains CTRL_VIDEO, PROCESSED)
#   Windows: "D:/DATA_DRIVE_MOVED/WAN2GP_LTX_BATCH"
#   Linux:   "/run/media/$USER/GAMES1/DATA_DRIVE_MOVED/WAN2GP_LTX_BATCH"
# WAN2GP_LTX_BATCH_DIR="D:/DATA_DRIVE_MOVED/WAN2GP_LTX_BATCH"
# WAN2GP_LTX_LORA: Default LoRA enhancement for LTX Video generation (bfs_head_swap, editanything_v2, deblur, etc.)
# WAN2GP_LTX_LORA="bfs_head_swap"

# Default Audio Player for playback and startup auto-play
# Options: mp_liquid_glass (default), mp_audio_player, strawberry, cliamp, vlc, haruna, kodi, mpv, audacity
DEFAULT_AUDIO_PLAYER="mp_liquid_glass"

# Standalone Liquid Glass Audio Player Backend: opengl or vulkan (default: opengl)
# opengl: High compatibility across AMD Radeon, Intel, NVIDIA, and older GPUs
# vulkan: NVIDIA Vulkan hardware pipeline
LIQUID_GLASS_BACKEND="opengl"

# Startup Autoplay Settings
# Set to "true" to automatically play a mix when the manager starts up
AUTO_PLAY_ON_STARTUP="true"

# Automatically open and display cover art on startup
AUTO_SHOW_COVER_ON_STARTUP="false"

# The Manager does not open a tracklist window on startup or when playback starts.
# Open a tracklist from the Tracklist menu, or press T in MP Audio Player.
AUTO_SHOW_TRACKLIST_ON_STARTUP="false"

# Default Tracklist Viewer (opens tracklist in a dedicated new window on boot)
# Options: console (default: OS default console / borderless terminal on Bazzite Linux), auto (external GUI editor), kwrite, kate, gedit, mousepad, konsole, xdg-open
TRACKLIST_VIEWER="console"

# Startup Mix Selection Mode: "latest" (newest mix), "random", or specific mix filename/keyword
AUTO_PLAY_MIX_SELECTION="latest"

# Startup Loader Video Settings
# Set to "true" to display the startup loader video (MP_loader.mp4) while the manager loads in the console.
# Automatically skipped if another instance of the manager is already open.
SHOW_LOADER_VIDEO="true"
LOADER_VIDEO_FILE="MP_loader.mp4"

# ==============================================================================
# Promotional & Publisher Outreach Email Settings
# ==============================================================================
# Senders information
PROMO_SENDER_NAME="MPlanetarian"
# PROMO_SENDER_EMAIL="artist@example.com"
# PROMO_REPLY_TO="artist@example.com"

# Outgoing SMTP Server (e.g., Gmail, Outlook, AWS SES, or Custom Mailserver)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="artist@example.com"
# SMTP_PASSWORD="" # Optional app password (can also be entered interactively)
# SMTP_USE_TLS="true"
# SMTP_USE_SSL="false"

# Default Promo & Streaming URLs
# PROMO_PODCAST_URL="https://podcasts.apple.com/..."
# PROMO_SOUNDCLOUD_URL="https://soundcloud.com/mplanetarian"
# PROMO_YOUTUBE_URL="https://youtube.com/@mplanetarian"
# PROMO_MIXCLOUD_URL="https://mixcloud.com/mplanetarian"
# PROMO_WEBSITE_URL="https://mplanetarian.com"

# ==============================================================================
# Universal Search & Import Mixes Settings (Local Drives & SMB)
# ==============================================================================
# Minimum file size in MB to qualify as a full mix (default: 100)
# SEARCH_IMPORT_MIN_SIZE_MB="100"

# Preferred default SMB host / share for mix ingest
# SMB_DEFAULT_HOST="192.168.1.138"

# ==============================================================================
# Option 1 — Music Folders (local drives and SMB shares only)
# ==============================================================================
# Music folders are not hard-coded. Add and remove them from Option 1, or with:
#   python3 scripts/music_folders_manager.py --add "\\\\host\\share"
#   python3 scripts/music_folders_manager.py --add "D:\\Music"
#   python3 scripts/music_folders_manager.py --remove MUSIC001
# The list for this machine is stored in ~/.config/mix-manager/music_folders.json
#
# Optional SMB credentials. The password is not written into the folder list.
# MUSIC_SMB_USER=""
# MUSIC_SMB_PASSWORD=""
# Linux/macOS rclone mount root. Windows opens the UNC path directly.
# MUSIC_SMB_MOUNT_ROOT="$HOME/MUSIC_SMB"
# Used once, only when music_folders.json does not exist yet:
# MUSIC_SMB_HOST=""
# MUSIC_SMB_SHARES=""

# Automatically prompt or run FLAC conversion after importing new WAV mixes
# AUTO_CONVERT_AFTER_IMPORT="true"

# ==============================================================================
# Video Player & Startup Custom YouTube Video Settings
# ==============================================================================
# Default Video Player for mix companion videos and visual playback
# Options: vlc, mpv, haruna, kodi
DEFAULT_VIDEO_PLAYER="vlc"

# Custom YouTube video URL to play on manager startup (e.g. ambient visualizer)
# Plays only if a mix is playing already in a music player
AUTO_PLAY_YOUTUBE_ON_STARTUP="false"
STARTUP_YOUTUBE_URL=""

# ==============================================================================
# Meteorological & Planetary Ephemeris Settings
# ==============================================================================
# Display current weather below the startup banner
WEATHER_ENABLED="true"

# Weather location (e.g., Swansea, UK or London, UK)
WEATHER_LOCATION="Swansea, UK"

# Display planets currently above the horizon for your location below the weather
PLANETS_ENABLED="true"

# ==============================================================================
# Traktor Database & Remote Top 5 Tracks Settings
# ==============================================================================
# Path to Traktor Pro 3/4 collection.nml or History directory
TRAKTOR_COLLECTION_PATH="/run/media/mplanetarian/WD BLACK B/MIX_ARCHIVE/Traktor 3.11.1/collection.nml"

# Root directory where audio files referenced in Traktor collection reside
TRAKTOR_AUDIO_ROOT="/run/media/mplanetarian/WD BLACK B/MIX_ARCHIVE"

# Traktor Audio Source Mode: local, smb, nfs, remote_mac
TRAKTOR_REMOTE_TYPE="local"

# Network SMB Share mount point (e.g. /run/user/1000/gvfs/... or /mnt/mac_smb)
TRAKTOR_SMB_MOUNT=""

# Network NFS Share mount point (e.g. /mnt/mac_nfs)
TRAKTOR_NFS_MOUNT=""

# Remote Mac Workstation SSH Details (for automated rsync/scp audio retrieval)
TRAKTOR_MAC_HOST=""
TRAKTOR_MAC_USER=""

# ==============================================================================
# Automated Mix Reports & Operational Telemetry Settings
# ==============================================================================
# Enable or disable automated daily mix reports (true/false)
DAILY_REPORTS_ENABLED="true"

# Scheduled daily update time in 24-hour HH:MM format (e.g. 10:00)
DAILY_REPORTS_TIME="10:00"

# Enable or disable monthly and yearly mix reports (true/false)
MONTHLY_REPORTS_ENABLED="true"
YEARLY_REPORTS_ENABLED="true"

# Last report generation markers (managed automatically by reporter)
LAST_DAILY_REPORT_RUN=""
LAST_MONTHLY_REPORT_RUN=""
LAST_YEARLY_REPORT_RUN=""

# ==============================================================================
# Studio & DJ Booth Mobile Web Companion Settings
# ==============================================================================
# Enable or disable the Web Companion server
WEB_COMPANION_ENABLED="true"

# Bind address (0.0.0.0 binds to all LAN interfaces, or specify 192.168.1.11)
WEB_COMPANION_HOST="0.0.0.0"

# Server listening port
WEB_COMPANION_PORT="8888"

# ==============================================================================
# Hardware MIDI Controller Settings (Traktor Kontrol S4 Exclusive - v0.4.0)
# ==============================================================================
# Enable or disable Traktor Kontrol S4 Hardware MIDI control (true / false)
MIDI_CONTROL_ENABLED="true"

# ALSA Hardware MIDI port for Traktor Kontrol S4
MIDI_DEVICE_PORT="hw:0,0"
MIDI_DEVICE_NAME="Traktor Kontrol S4"

# Set to true once the user has been notified of first-time detection
TRAKTOR_S4_NOTIFIED="false"

